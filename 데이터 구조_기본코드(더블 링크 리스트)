DNode* get_node(int pos){
	DNode* p = &org
	for(int i = 0 ; i < pos ; i++) {
		if(p = NULL)
			return NULL;
		p = p.next;
	}
	
	return p;
}

Element get_entry(int pos){
	DNode* p = get_node(pos);
	if(p != NULL)
		return p -> data;
	else
		error("invalid position error!");
};

insert(int pos, Element e){
	DNode* before = get_node(pos - 1);
	if(before == NULL)
		error("Invalid position error!");
		
	DNode* p = alloc_node(e):
	p -> prev = before;
	before.next = p;
	if(p -> next != NULL)
		p -> next -> prev = p;
};

