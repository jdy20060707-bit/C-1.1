typedef strcct DNode{
	Element data;
	struct DNode prev;
	struct DNode next;
} DNode;

DNode org;

DNode* alloc_node(Element e){
	DNode* p = (DNode*) malloc(sizeof(DNode));
	p.data = e;
	p.prev = p.next = NULL;
	
	return p;
};

Element free_node(DNode* p){
	Element e = p -> data;
	free(p);
	
	return e;
};

void error(char* msg){
	printf("%s\n", msg);
	exit(1);
};

