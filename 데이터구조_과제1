#include <stdio.h>
#define ROWS 3  //행의 크기
#define COLS 3  //열의 크기

void add_mat(int a[ROWS][COLS], int b[ROWS][COLS], int c[ROWS][COLS]);
void mult_mat(int a[ROWS][COLS], int b[ROWS][COLS], int c[ROWS][COLS]);

void print_mat(int m[ROWS][COLS], char* str)
{
    printf("%s\n", str);
    for (int i = 0; i < ROWS; i++){
        for (int j = 0; j < COLS; j++){
            printf("%3d", m[i][j]);
        }
        printf("\n");
    }
}
void transpose_mat(int m[ROWS][COLS])
{
    for (int i = 0; i < ROWS; i++){
        for (int j = i+1; j < COLS; j++){
            int tmp = m[i][j];
            m[i][j] = m[j][i];
            m[j][i] = tmp;
        }
    }
}
int main(void)
{
    int mat[ROWS][COLS] = {4, 0, 1, 1, 6, 5, 7, 3, 6};
    int a[ROWS][COLS] = {4, 0, 1, 1, 6, 5, 7, 3, 6};
    int b[ROWS][COLS] = {1, 2, 3, 5 ,8, 4, 2, 1};
    int c[ROWS][COLS] = {0, };
    print_mat(mat, "원래 행렬");
    transpose_mat(mat);
    print_mat(mat, "전치 행렬");
    
    add_mat(a,b,c);
    print_mat(c, "add a + b");

    mult_mat(a,b,c);
    print_mat(c, "a * b ");

    return 0;
}

void add_mat(int a[ROWS][COLS], int b[ROWS][COLS], int c[ROWS][COLS]) //행렬의 합
{
    for (int i = 0; i  < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            c[i][j] = a[i][j] + b[i][j];
        }
    }
}
void mult_mat(int a[ROWS][COLS], int b[ROWS][COLS], int c[ROWS][COLS]) //행렬의 곱
{
    for (int i = 0; i  < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            c[i][j] = 0;
            for (int k = 0; k < COLS; k++) {
            c[i][j] += a[i][k] * b[k][j];
            }
        }
    }
}
